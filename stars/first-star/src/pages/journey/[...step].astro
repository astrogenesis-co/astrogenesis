---
import { chapters } from "../../lib/journey.mjs";
import { getCatalog, preview, dateLabel } from "../../lib/catalog.mjs";
import "../../styles/journey.css";
export function getStaticPaths() {
  return preview
    ? [
        { params: { step: undefined } },
        ...chapters.map((chapter, index) => ({
          params: { step: chapter.id },
          props: { chapter, index },
        })),
      ]
    : [];
}
const { chapter: c, index = -1 } = Astro.props;
const catalog = c?.listen ? getCatalog() : [];
const versions = catalog
  .filter(
    (e) => e.group === "mixes" && e.song === `songs/${c?.song}` && e.audio,
  )
  .sort((a, b) => a.mixDate.localeCompare(b.mixDate));
const selected =
  versions.length > 1 ? [versions[0], versions.at(-1)] : versions;
const next = chapters[index + 1];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>{c ? c.displayTitle : 'The journey'} — First Star</title>
    <link rel="icon" href="/favicon.png" />
  </head>
  <body
    style={`--accent: ${c?.color || "#e9c989"}`}
    data-stage={c?.id || "opening"}
  >
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header>
      <a class="brand" href="/">
        ✳ <span>FIRST STAR</span>
      </a>
      <nav aria-label="Main">
        <a href="/journey/" aria-current="page">
          Journey
        </a>
        <a href="/explore/">Explore ↗</a>
      </nav>
      <span class="prototype">WORK IN PROGRESS</span>
    </header>
    <aside class="work-in-progress" aria-label="Work in progress">
      <strong>A work in progress.</strong>
      <span>This is an early sketch of the journey. Some words, memories, and music are placeholders; the experience will change as it grows.</span>
    </aside>
    <main id="main">
      {!c ? (
        <>
          <section class="opening">
            <div class="opening-copy">
              <p class="eyebrow">First Star / Memory & music</p>
              <h1>
                Before
                <br />
                there were
                <br />
                <em>words.</em>
              </h1>
              <p class="intro">
                A path through memory and music.
                <br />
                Some things stay with you. Some sound different when you return.
              </p>
              <a class="primary" href="/journey/creation/">
                Begin <span>→</span>
              </a>
              <a class="resume" hidden href="/journey/creation/">
                Continue where you left off →
              </a>
            </div>
            <div class="opening-art" aria-hidden="true">
              <div class="orbit orbit-one"></div>
              <div class="orbit orbit-two"></div>
              <div class="orbit orbit-three"></div>
              <div class="sun"></div>
              <span class="art-caption">EVERYTHING BEGINS SOMEWHERE</span>
            </div>
          </section>
          <section class="orientation">
            <p class="eyebrow">Take your time</p>
            <p>
              A sound can bring you back to somewhere you thought you had left.
              A memory can change what you hear.
            </p>
            <p class="muted">
              Listen, linger, follow what draws you. You can always come back.
            </p>
          </section>
          <details class="journey-map">
            <summary>
              Find a place to begin <span>↗</span>
            </summary>
            <ol class="chapter-map">
              {chapters.map((ch, i) => (
                <li>
                  <a href={`/journey/${ch.id}/`}>
                    <span class="number">0{i + 1}</span>
                    <span>
                      <strong>{ch.displayTitle}</strong>
                      <small>{ch.subtitle}</small>
                    </span>
                    <span class="map-arrow">↗</span>
                  </a>
                </li>
              ))}
            </ol>
          </details>
        </>
      ) : (
        <>
          <nav class="stage-nav" aria-label="Places in the journey">
            {chapters.map((ch, i) => (
              <a
                href={`/journey/${ch.id}/`}
                aria-current={ch.id === c.id ? "step" : undefined}
              >
                <span>0{i + 1}</span>
                <span>{ch.displayTitle}</span>
              </a>
            ))}
          </nav>
          <section class="chapter-hero">
            <div>
              <p class="eyebrow">{c.era}</p>
              <h1>{c.displayTitle}</h1>
              <p class="chapter-subtitle">{c.subtitle}</p>
            </div>
            <div class="chapter-art" aria-hidden="true">
              <div class="halo"></div>
              <div class="orb"></div>
            </div>
          </section>
          <div class="chapter-body">
            <aside class="margin-note">
              <span class="eyebrow">The life</span>
              <span>{c.era}</span>
              <span class="hairline"></span>
              <span>Memory & music</span>
            </aside>
            <div class="story">
              <p class="lead">{c.text}</p>
              <section class="memory">
                <p class="eyebrow">Memory / space to be filled</p>
                <h2>{c.memory}</h2>
                <p>{c.prompt}</p>
                <span class="placeholder-date">Date or age to be added</span>
              </section>
              <section class="listening">
                <p class="eyebrow">The music</p>
                <h2>{c.sound}</h2>
                <p>{c.soundText}</p>
                {c.listen &&
                  selected.map((mix, i) => (
                    <div class="recording">
                      <div>
                        <span class="eyebrow">
                          {selected.length === 1
                            ? "Selected recording"
                            : i === 0
                              ? "Earlier recording"
                              : "Later recording"}
                        </span>
                        <h3>{c.song === "genesis" ? "Genesis" : "Coldness"}</h3>
                        <span class="record-date">
                          {dateLabel(mix.mixDate)}
                        </span>
                      </div>
                      <audio controls preload="none" src={mix.audio}>
                        Audio playback is unavailable.
                      </audio>
                      <p class="audio-error" hidden>
                        Unable to load this recording.{" "}
                        <a href={`/explore/${mix.key}/`}>
                          Open its catalog page ↗
                        </a>
                      </p>
                    </div>
                  ))}
                {c.listen && !selected.length && (
                  <p class="muted">
                    Listening copies are not available in this preview.
                  </p>
                )}
                {c.song && (
                  <a
                    class="text-link"
                    href={`/explore/songs/${c.song}/?journey=${c.id}`}
                  >
                    Follow {c.song === "genesis" ? "Genesis" : "Coldness"} in
                    Explore ↗
                  </a>
                )}
              </section>
              <section class="reflection">
                <p class="eyebrow">Looking back, from here</p>
                <p>{c.reflection}</p>
                {c.id === "resurrection" && (
                  <a class="text-link" href="/journey/creation/">
                    Go back to the beginning ↗
                  </a>
                )}
              </section>
            </div>
          </div>
          <footer class="chapter-end">
            <a
              href={
                index > 0 ? `/journey/${chapters[index - 1].id}/` : "/journey/"
              }
            >
              ← {index > 0 ? chapters[index - 1].displayTitle : "Overview"}
            </a>
            {next ? (
              <a class="next" href={`/journey/${next.id}/`}>
                <span class="eyebrow">Keep going</span>
                <strong>{next.displayTitle} →</strong>
              </a>
            ) : (
              <a class="next" href="/explore/">
                <span class="eyebrow">Keep following the work</span>
                <strong>Enter Explore ↗</strong>
              </a>
            )}
          </footer>
        </>
      )}
    </main>
    <footer class="site-footer">
      <a href="/journey/">First Star / The journey</a>
      <p>
        Work in progress · Sample text.
        <br />
        Memories and music are still finding their place.
      </p>
    </footer>
    <script>
      const id = document.body.dataset.stage;
      try {
        if (id && id !== "opening")
          localStorage.setItem("first-star-journey", id);
        else {
          const saved = localStorage.getItem("first-star-journey");
          const valid = [
            "creation",
            "fall",
            "promise",
            "incarnation",
            "crucifixion",
            "resurrection",
            "love",
          ];
          const resume = document.querySelector<HTMLAnchorElement>(".resume");
          if (saved && valid.includes(saved) && resume) {
            resume.href = `/journey/${saved}/`;
            resume.hidden = false;
          }
        }
      } catch {}
      const players = [...document.querySelectorAll("audio")];
      players.forEach((player) => {
        player.addEventListener("play", () =>
          players.forEach((other) => {
            if (other !== player) other.pause();
          }),
        );
        player.addEventListener("error", () => {
          const error =
            player.parentElement?.querySelector<HTMLElement>(".audio-error");
          if (error) error.hidden = false;
        });
      });
    </script>
  </body>
</html>
