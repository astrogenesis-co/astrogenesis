{
  "name": "first-star",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "EXPLORE_PREVIEW=1 astro dev --host 127.0.0.1",
    "build": "astro build",
    "build:preview": "EXPLORE_PREVIEW=1 astro build",
    "preview": "astro preview --host 127.0.0.1",
    "preview:drafts": "EXPLORE_PREVIEW=1 astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "audio:upload": "node scripts/upload-audio.mjs",
    "format": "prettier --write src tests astro.config.mjs",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc",
    "audio:verify": "node scripts/verify-audio.mjs",
    "audio:publish": "npm run audio:upload && npm run audio:verify"
  },
  "dependencies": {
    "astro": "^7.3.2",
    "gray-matter": "^4.0.3",
    "marked": "^18.0.13",
    "sanitize-html": "^2.17.7",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^1.0.0",
    "wrangler": "^4.131.2"
  }
}
